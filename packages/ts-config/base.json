{
	"compilerOptions": {
		"composite":  false,
		"declaration": true,
		"declarationMap": true,
		"esModuleIntarop": true,
		"forceConsistentCasingInFileNames": true,
    "inlineSources": false,
		"isolatedModules": true,
    "moduleResolution": "node",
    "noUnsedLocals": false,
		"noUnusedParameters": false,
    "preserveWatchOutput": true,
		"skipLibCheck": true,
		"strict": true
	},
	"exclude": ["node_modules"]
}
